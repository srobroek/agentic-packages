{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/notify.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/chezmoi-sync.sh"
          },
          {
            "type": "command",
            "if": "Edit(*.d2)|Write(*.d2)",
            "command": "./scripts/validate-d2.sh",
            "timeout": 5,
            "statusMessage": "Checking D2 diagram quality..."
          },
          {
            "type": "command",
            "command": "./scripts/quality-edit-advisory.sh",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "./scripts/debug-stuck-detector.sh",
            "async": true,
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(cargo test*)|Bash(just test*)|Bash(pnpm test*)|Bash(pnpm run test*)|Bash(pytest*)|Bash(python -m pytest*)|Bash(go test*)|Bash(dotnet test*)|Bash(vitest*)|Bash(jest*)|Bash(cargo clippy*)|Bash(ruff check*)|Bash(cargo build*)|Bash(just build*)|Bash(pnpm run build*)",
            "command": "./scripts/test-state-tracker.sh"
          },
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "./scripts/speckit-task-commit-check.sh"
          },
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "./scripts/stuck-reset.sh",
            "async": true,
            "timeout": 2
          },
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "./scripts/reindex-after-commit.sh",
            "async": true,
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(git merge*)",
            "command": "./scripts/post-merge-cleanup.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(git switch -c*)|Bash(git switch --create*)|Bash(git checkout -b*)|Bash(git checkout -B*)|Bash(git worktree add*)|Bash(git merge*)|Bash(git pull*)|Bash(git rebase*)",
            "command": "./scripts/repomix-refresh-snapshot.sh",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Read",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/code-discovery-steer.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/agentic-source-guard.sh"
          },
          {
            "type": "command",
            "command": "./scripts/chezmoi-guard.sh"
          },
          {
            "type": "command",
            "if": "Edit(Cargo.toml)|Edit(package.json)|Edit(pyproject.toml)|Edit(go.mod)|Edit(Gemfile)|Edit(composer.json)|Write(Cargo.toml)|Write(package.json)|Write(pyproject.toml)|Write(go.mod)|Write(Gemfile)|Write(composer.json)",
            "command": "./scripts/package-file-warn.sh"
          },
          {
            "type": "command",
            "command": "./scripts/coder-delegation-reminder.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/agentic-source-guard.sh"
          },
          {
            "type": "command",
            "command": "./scripts/bash-guard.sh"
          },
          {
            "type": "command",
            "if": "Bash(gh *)|Bash(*gh-api.py gh *)",
            "command": "./scripts/gh-rate-guard.sh"
          },
          {
            "type": "command",
            "if": "Bash(pnpm add*)|Bash(cargo add*)|Bash(uv add*)|Bash(pip install*)",
            "command": "./scripts/pkg-version-warn.sh"
          },
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "./scripts/git-guard.sh"
          },
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "./scripts/pre-commit-test-gate.sh"
          },
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "./scripts/quality-before-commit.sh"
          },
          {
            "type": "command",
            "if": "Bash(ls *)|Bash(cat *)|Bash(find *)|Bash(grep *)|Bash(du *)|Bash(df *)|Bash(head *)|Bash(tail *)",
            "command": "./scripts/enforce-tool-prefs.sh"
          },
          {
            "type": "command",
            "if": "Bash(*&&*)|Bash(*;*)",
            "command": "./scripts/approve-compound-bash.sh",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "./scripts/safe-commands.sh"
          },
          {
            "type": "command",
            "if": "Bash(gh issue close*)|Bash(*gh issue close*)|Bash(glab issue close*)",
            "command": "./scripts/speckit-issue-close-guard.sh"
          },
          {
            "type": "command",
            "if": "Bash(gh pr create*)|Bash(*gh pr create*)|Bash(*gh-api.py*pr create*)|Bash(glab mr create*)|Bash(*glab mr create*)",
            "command": "./scripts/speckit-pr-issue-refs.sh"
          },
          {
            "type": "command",
            "if": "Bash(gh issue create*)|Bash(*gh issue create*)|Bash(glab issue create*)|Bash(*glab issue create*)",
            "command": "./scripts/speckit-issue-label-guard.sh"
          },
          {
            "type": "command",
            "if": "Bash(git merge*)",
            "command": "./scripts/no-ff-guard.sh",
            "timeout": 3
          },
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "./scripts/attribution-guard.sh",
            "timeout": 3
          },
          {
            "type": "command",
            "if": "Bash(gh pr merge*)|Bash(*gh pr merge*)",
            "command": "./scripts/squash-merge-guard.sh",
            "timeout": 3
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "if": "Agent(*)",
            "command": "./scripts/concurrent-limit.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/speckit-context7-reminder.sh"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/failure-logger.sh",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": ".envrc",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Environment file changed. Run: eval $(direnv export bash) or restart shell.'",
            "statusMessage": "Detected .envrc change"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/subagent-context-inject.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/codebase-index.sh",
            "async": true,
            "statusMessage": "Indexing codebase..."
          },
          {
            "type": "command",
            "command": "./scripts/worktree-orphan-cleanup.sh",
            "async": true,
            "timeout": 60
          },
          {
            "type": "command",
            "command": "./scripts/apm-outdated-check.sh",
            "asyncRewake": true,
            "timeout": 30
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/worktree-create.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/speckit-stop-gate.sh"
          },
          {
            "type": "command",
            "command": "./scripts/uncommitted-warn.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/session-end-prune.sh",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "speckit-implement-task",
        "hooks": []
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/agent-metrics.sh",
            "async": true
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": []
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/worktree-cleanup.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/branch-check.sh"
          },
          {
            "type": "command",
            "command": "./scripts/speckit-deferred-issues.sh"
          }
        ]
      }
    ]
  }
}
