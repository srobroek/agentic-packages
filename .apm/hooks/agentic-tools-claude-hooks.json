{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/./scripts/notify.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/./scripts/failure-logger.py",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": ".envrc",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Environment file changed. Run: eval $(direnv export bash) or restart shell.'",
            "timeout": 5,
            "statusMessage": "Detected .envrc change"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/./scripts/apm-outdated-check.py",
            "asyncRewake": true,
            "timeout": 30
          }
        ]
      }
    ]
  }
}
