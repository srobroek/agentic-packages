apm.lock.yaml
apm_modules/
AGENTS.md
CLAUDE.md
GEMINI.md
# AGENTS.md is ignored anywhere (APM compiles AGENTS.md into subdirs per applyTo
# globs). Negate the hand-authored docs page so it is tracked.
!/docs/agents.md
.codex/
.claude/
/.github/*
!/.github/workflows/
!/.github/ISSUE_TEMPLATE/
!/.github/PULL_REQUEST_TEMPLATE.md
!/.github/actionlint.yaml
!/.github/requirements-ci.txt
!/.github/zizmor.yml
/.cursor/
/.opencode/
/.gemini/
/.windsurf/
/.agents/*
!/.agents/plugins/
/.agents/plugins/*
!/.agents/plugins/marketplace.json
# apm pack also emits a Claude plugin manifest; only the marketplace.json is tracked.
/.claude-plugin/plugin.json
build/
dist/
__pycache__/
*.pyc
# No project venv is needed: scripts are PEP 723 and run via `uv run --script`.
# A bare `uv run --with ...` still materializes one from pyproject.toml, so ignore
# it rather than let it be committed.
.venv/

# SpecKit: ignore fetched/built extension artifacts (refetched/rebuilt locally),
# keep the lean .specify/ config (manifests, templates, workflows, integration).
.specify/extensions/*/node_modules/
.specify/extensions/*/dist/
.specify/**/__pycache__/
.specify/**/.pytest_cache/
.specify/extensions/.cache/
# SpecKit extensions are fetched/installed by setup-speckit.sh (refetchable,
# like apm_modules). Ignore the vendored extension trees; keep .specify/ config,
# templates, workflows, and integration state committed.
.specify/extensions/
# Machine-local runtime state: absolute install-time `source` paths that only
# resolve on the host that ran setup-speckit.sh (regenerated locally). Not
# portable — must not travel with the repo.
.specify/workflows/workflow-registry.json

# uv lockfiles (runner is dependency-free; no committed lock)
uv.lock

# Internal scratch: decision logs, proposals, audits (not for the public repo)
reviews/
.ruff_cache/

# Machine-local tooling state: headroom session cache, per-host MCP config,
# in-repo git worktrees
.headroom/
/.mcp.json
/.worktrees/

# repomix's DEFAULT output names. Any bare `repomix` run in the repository root
# writes these, and they are ~40 MB: two were committed by a tuning sweep that
# omitted --output, and CI caught them only via a typos scan of the packed
# content.
/repomix-output.xml
/repomix-output.md
/repomix-output.txt
/repomix.xml
repomix-full.xml

# graphify's index. `graphify update` has no output flag, so it writes into the
# tree unavoidably: 9.9 MB here, 60 MB on a 4,107-file repository. It is also in
# the repomix ignore list, because an unignored index gets packed into the next
# one -- it measured 38% of one repository's entire pack. Listed in
# .worktreeinclude so a new worktree copies it instead of rebuilding.
graphify-out/

# Agent conformance run outputs (gitignored; see packages/agent-conformance)
.conformance-runs/

# Audit raw evidence: per-agent transcripts (large, disposable).
.audit-2026-07/raw/
