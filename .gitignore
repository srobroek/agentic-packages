apm.lock.yaml
apm_modules/
AGENTS.md
CLAUDE.md
GEMINI.md
# AGENTS.md is ignored anywhere (APM compiles AGENTS.md into subdirs per applyTo
# globs). Negate the hand-authored docs page so it is tracked.
!/docs/agents.md
.codex/
.claude/
/.github/*
!/.github/workflows/
!/.github/ISSUE_TEMPLATE/
!/.github/PULL_REQUEST_TEMPLATE.md
/.cursor/
/.opencode/
/.gemini/
/.windsurf/
/.agents/*
!/.agents/plugins/
/.agents/plugins/*
!/.agents/plugins/marketplace.json
# apm pack also emits a Claude plugin manifest; only the marketplace.json is tracked.
/.claude-plugin/plugin.json
build/
dist/
__pycache__/
*.pyc

# SpecKit: ignore fetched/built extension artifacts (refetched/rebuilt locally),
# keep the lean .specify/ config (manifests, templates, workflows, integration).
.specify/extensions/*/node_modules/
.specify/extensions/*/dist/
.specify/**/__pycache__/
.specify/**/.pytest_cache/
.specify/extensions/.cache/
# SpecKit extensions are fetched/installed by setup-speckit.sh (refetchable,
# like apm_modules). Ignore the vendored extension trees; keep .specify/ config,
# templates, workflows, and integration state committed.
.specify/extensions/

# uv lockfiles (runner is dependency-free; no committed lock)
uv.lock
