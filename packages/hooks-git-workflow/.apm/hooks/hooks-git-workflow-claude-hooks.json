{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/pre-commit-test-gate.sh",
            "if": "Bash(git commit*)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/uncommitted-warn.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/test-state-tracker.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/test-state-tracker.sh",
            "if": "Bash(cargo test*)|Bash(just test*)|Bash(pnpm test*)|Bash(pnpm run test*)|Bash(pytest*)|Bash(python -m pytest*)|Bash(go test*)|Bash(dotnet test*)|Bash(vitest*)|Bash(jest*)|Bash(cargo clippy*)|Bash(ruff check*)|Bash(cargo build*)|Bash(just build*)|Bash(pnpm run build*)"
          }
        ]
      }
    ]
  }
}
