#!/usr/bin/env bash
set -Eeuo pipefail

: "${FAKE_STATE:?FAKE_STATE is required}"
: "${FAKE_SCENARIO:?FAKE_SCENARIO is required}"
printf '%s\n' "$*" >>"$FAKE_STATE/git.log"

case "${1:-}" in
hash-object)
  # A REAL git blob hash, not a bare sha1 of the content. git prefixes
  # "blob <bytelength>\0" before hashing, so the two differ for every input --
  # `printf hello | git hash-object --stdin` is b6fc4c62..., while sha1("hello")
  # is aaf4c61d...
  #
  # This matters more than a fixture detail. The digests this command produces ARE
  # the waiter ids, native holder tokens, failure keys, and sheepdog wisp ids. While
  # the fake computed a bare sha1 and the test helpers recomputed it the same way,
  # the suite was self-consistent but could not detect digest drift -- the one
  # failure a rewrite is most likely to introduce.
  _payload="$(cat)"
  printf 'blob %d\0%s' "${#_payload}" "$_payload" | shasum -a 1 | awk '{print $1}'
  ;;
fetch | cat-file)
  exit 0
  ;;
rev-parse)
  printf '%s\n' "$REMOTE_BASE"
  ;;
merge-tree)
  printf 'ffffffffffffffffffffffffffffffffffffffff\n'
  ;;
diff)
  printf 'path/to/file.txt\0'
  ;;
ls-tree)
  if [[ "$FAKE_SCENARIO" == "land-stack-hold" && "${2:-}" == "$REMOTE_BASE" ]]; then
    printf '100644 blob 3333333333333333333333333333333333333333\tpath/to/file.txt\n'
  else
    printf '100644 blob 2222222222222222222222222222222222222222\tpath/to/file.txt\n'
  fi
  ;;
*)
  printf 'unexpected fake git invocation: %s\n' "$*" >&2
  exit 99
  ;;
esac
