{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/beads-gh-issue-guard.sh",
            "statusMessage": "Checking gh issue command against beads policy..."
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/beads-jsonl-export.sh",
            "statusMessage": "Refreshing beads JSONL export for commit..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/beads-subagent-reminder.sh",
            "statusMessage": "Injecting beads work contract..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/beads-jsonl-import.sh",
            "statusMessage": "Hydrating beads from committed JSONL..."
          }
        ]
      }
    ]
  }
}
