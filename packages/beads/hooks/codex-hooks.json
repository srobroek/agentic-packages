{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/beads-gh-issue-guard.py",
            "statusMessage": "Checking gh issue command against beads policy...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/beads-sync-stage.sh",
            "statusMessage": "Staging beads JSONL for commit...",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/beads-subagent-reminder.py",
            "statusMessage": "Injecting beads work contract...",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/beads-sync-hydrate.sh",
            "statusMessage": "Syncing beads (Dolt pull, JSONL fallback)...",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/beads-maintenance-check.sh",
            "statusMessage": "Checking beads database size...",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/beads-sync-push.sh",
            "statusMessage": "Publishing beads state...",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
