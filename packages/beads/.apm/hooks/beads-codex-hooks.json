{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/beads-gh-issue-guard.sh",
            "statusMessage": "Checking gh issue command against beads policy...",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/beads-subagent-reminder.sh",
            "statusMessage": "Injecting beads work contract...",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
