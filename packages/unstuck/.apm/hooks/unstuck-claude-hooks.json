{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/debug-stuck-detector.sh",
            "async": true,
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/stuck-reset.sh",
            "if": "Bash(git commit*)",
            "async": true,
            "timeout": 2
          }
        ]
      }
    ]
  }
}
