{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/adr-write-guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
