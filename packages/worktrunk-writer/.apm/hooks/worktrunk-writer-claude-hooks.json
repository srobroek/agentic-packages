{
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && python3 ${PLUGIN_ROOT}/.apm/skills/worktrunk-writer/scripts/context-handshake.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && python3 ${PLUGIN_ROOT}/.apm/skills/worktrunk-writer/scripts/worktrunk-writer.py hook",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && python3 ${PLUGIN_ROOT}/.apm/skills/worktrunk-writer/scripts/worktrunk-writer.py hook",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "domain-specialist|domain-specialist-high|shepherd|reviewer|researcher|advisor|scribe",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && python3 ${PLUGIN_ROOT}/.apm/skills/worktrunk-writer/scripts/worktrunk-writer.py subagent-exit",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
