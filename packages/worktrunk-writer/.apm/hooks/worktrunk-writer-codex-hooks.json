{
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && python3 ${PLUGIN_ROOT}/.apm/skills/worktrunk-writer/scripts/context-handshake.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|send_message|followup_task|send_input|multi_agent_v1send_input|resume_agent|multi_agent_v1resume_agent",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && python3 ${PLUGIN_ROOT}/.apm/skills/worktrunk-writer/scripts/worktrunk-writer.py hook",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|apply_patch|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && python3 ${PLUGIN_ROOT}/.apm/skills/worktrunk-writer/scripts/worktrunk-writer.py hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
