{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/rtk-rewrite-guard.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/repomix-read-guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/repomix-read-guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/spill-tool-output.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/read-truncation-notice.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
