{
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet ${PLUGIN_ROOT}/.apm/hooks/scripts/contract-start.py",
            "statusMessage": "Injecting bead-as-brief claim contract...",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "RULES_DIR=${PLUGIN_ROOT}/.apm/rules uv run --quiet ${PLUGIN_ROOT}/.apm/hooks/scripts/rules-eval.py",
            "statusMessage": "Evaluating bead contract...",
            "timeout": 45
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet ${PLUGIN_ROOT}/.apm/hooks/scripts/orchestrator-claim-deny.py",
            "statusMessage": "Checking orchestrator claim policy...",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
