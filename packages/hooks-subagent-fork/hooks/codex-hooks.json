{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/subagent-fork-guard.sh",
            "statusMessage": "Checking spawn fork_turns against policy...",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/subagent-fork-inject.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
