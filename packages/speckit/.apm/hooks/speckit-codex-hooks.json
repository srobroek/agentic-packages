{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/dispatcher.sh",
            "args": ["pre"],
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/dispatcher.sh",
            "args": ["pre"],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/dispatcher.sh",
            "args": ["post"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
