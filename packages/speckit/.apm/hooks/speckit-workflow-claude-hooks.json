{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/speckit-context7-reminder.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/speckit-issue-close-guard.sh",
            "if": "Bash(gh issue close*)|Bash(*gh issue close*)|Bash(glab issue close*)"
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/speckit-issue-label-guard.sh",
            "if": "Bash(gh issue create*)|Bash(*gh issue create*)|Bash(glab issue create*)|Bash(*glab issue create*)"
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/speckit-pr-issue-refs.sh",
            "if": "Bash(gh pr create*)|Bash(*gh pr create*)|Bash(*gh-api.py*pr create*)|Bash(glab mr create*)|Bash(*glab mr create*)"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/speckit-deferred-issues.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/speckit-stop-gate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/speckit-task-commit-check.sh",
            "if": "Bash(git commit*)"
          }
        ]
      }
    ]
  }
}
