{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/speckit-task-commit-check.sh",
            "if": "Bash(git commit*)"
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/speckit-task-issue-sync.sh"
          }
        ]
      }
    ]
  }
}
