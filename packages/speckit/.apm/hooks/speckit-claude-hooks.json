{
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "speckit\\..*",
        "hooks": [
          {
            "type": "command",
            "command": "../skills/speckit-dag/scripts/dispatcher.sh",
            "args": ["pre"],
            "timeout": 5,
            "statusMessage": "Checking SpecKit DAG preconditions..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "if": "Skill(speckit\\..*)",
            "command": "../skills/speckit-dag/scripts/dispatcher.sh",
            "args": ["pre"],
            "timeout": 5,
            "statusMessage": "Checking SpecKit DAG preconditions..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "if": "Skill(speckit\\..*)",
            "command": "../skills/speckit-dag/scripts/dispatcher.sh",
            "args": ["post"],
            "timeout": 5,
            "statusMessage": "Loading SpecKit next-step context..."
          }
        ]
      }
    ]
  }
}
