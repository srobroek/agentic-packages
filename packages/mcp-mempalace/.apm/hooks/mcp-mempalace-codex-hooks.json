{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/mempalace-wake-up.sh",
            "statusMessage": "Loading MemPalace wake-up context...",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
